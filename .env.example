# HiveMind configuration. Copy to .env and adjust.
# Every variable is optional, carries the HIVEMIND_ prefix, and defaults to the
# value in hivemind/config.py. docker-compose.yml sets HIVEMIND_DATABASE_URL and
# HIVEMIND_REDIS_URL itself to reach its own postgres and redis services.

# Signing key for the JWT bearer tokens accepted by the MCP tools. Change it.
HIVEMIND_SECRET_KEY=change-me

# DNS rebinding guard on the MCP endpoint (fastmcp 4). Comma-separated list of
# hostnames accepted in the Host header; a Host outside the list gets 421.
# Ports need not be listed, "localhost:8000" is normalised to "localhost".
# Add the public hostname when the server is reached by anything other than
# localhost, for instance HIVEMIND_ALLOWED_HOSTS=localhost,127.0.0.1,hivemind.example.com
# HIVEMIND_ALLOWED_HOSTS=localhost,127.0.0.1

# Storage (defaults target a local PostgreSQL with pgvector, and a local Redis)
# HIVEMIND_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hivemind
# HIVEMIND_REDIS_URL=redis://localhost:6379/0

# Embeddings (must stay constant for the life of a database)
# HIVEMIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HIVEMIND_EMBEDDING_DIMENSIONS=384

# Optional LLM stages (conflict resolution, third deduplication stage).
# Empty means those stages are skipped.
# HIVEMIND_ANTHROPIC_API_KEY=
